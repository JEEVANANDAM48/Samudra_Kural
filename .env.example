PROJECT_NAME="Samudra Kural Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
DEMO_MODE=False

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="samudra"
POSTGRES_PASSWORD="samudra_dev_password"
POSTGRES_DB="samudra_kural"
ASYNC_DATABASE_URL="postgresql+asyncpg://samudra:samudra_dev_password@localhost:5432/samudra_kural"

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET_KEY="samudra_kural_dev_secret_key_change_in_production_32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# COPERNICUS MARINE AUTHENTICATION
# ============================================================
COPERNICUSMARINE_SERVICE_USERNAME="YOUR_COPERNICUS_USERNAME"
COPERNICUSMARINE_SERVICE_PASSWORD="YOUR_COPERNICUS_PASSWORD"

# ============================================================
# COPERNICUS PRODUCTS
# ============================================================
COPERNICUS_PHY_PRODUCT_ID="GLOBAL_ANALYSISFORECAST_PHY_001_024"
COPERNICUS_WAV_PRODUCT_ID="GLOBAL_ANALYSISFORECAST_WAV_001_027"

# ============================================================
# COPERNICUS DATASETS
# ============================================================
COPERNICUS_PHY_DATASET_ID="cmems_mod_glo_phy-cur_anfc_0.083deg_PT6H-i"
COPERNICUS_WAV_DATASET_ID="cmems_mod_glo_wav_anfc_0.083deg_PT3H-i"

# ============================================================
# INCOIS CONFIGURATION
# ============================================================
INCOIS_BASE_URL="https://incois.gov.in"
INCOIS_DATA_DIR="data/incois"
INCOIS_CACHE_TTL_MINUTES=180

# ============================================================
# APPLICATION & DRIFT MODEL
# ============================================================
ENVIRONMENT_CACHE_MINUTES=30
DEFAULT_PREDICTION_STEP_MINUTES=30
GPS_ARRIVAL_RADIUS_METERS=200
